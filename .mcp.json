{
  "mcpServers": {
    "ghidra-dao": {
      "type": "http",
      "url": "http://127.0.0.1:8090/mcp"
    },
    "eluvian": {
      "command": "python",
      "args": [
        "${ELUVIAN_DIR:-C:/project/DAOEluvianMCP}/tools/eluvian_bridge.py"
      ]
    },
    "ghilana": {
      "command": "${ELUVIAN_DIR:-C:/project/DAOEluvianMCP}/build/ghilana-release/ghilana.exe",
      "args": [
        "--instance",
        "elgara-agent"
      ]
    }
  }
}
